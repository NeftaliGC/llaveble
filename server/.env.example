# Copia este archivo como .env y ajusta los valores

# Puerto del servidor (el túnel HTTPS apunta aquí)
PORT=3000

# Contraseña del dueño para entrar al panel
OWNER_PASSWORD=cambia-esta-contrasena

# Identificador del portón (debe coincidir con GATE_ID en firmware/include/config.h)
GATE_ID=porton-01

# Clave compartida con el ESP32 para sincronizar (debe coincidir con DEVICE_KEY en config.h)
DEVICE_KEY=cambia-esta-clave-del-dispositivo

# Zona horaria de los horarios (Ciudad de México = -06:00, sin horario de verano)
TZ_OFFSET=-06:00

# (Opcional) URL pública del túnel, p. ej. https://algo.trycloudflare.com
# Si se deja vacía se usa la dirección con la que se abrió el panel.
PUBLIC_URL=
